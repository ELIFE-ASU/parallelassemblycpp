{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "warnings": {
        "dev": true,
        "deprecated": true,
        "uninitialized": true,
        "unusedCli": true
      },
      "errors": {
        "dev": true,
        "deprecated": true
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "PARALLELASSEMBLYCPP_STRICT_WARNINGS": true
      }
    },
    {
      "name": "dev",
      "displayName": "Developer",
      "description": "Portable build with focused tests and telemetry",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": true,
        "PARALLELASSEMBLYCPP_BUILD_TELEMETRY": true,
        "PARALLELASSEMBLYCPP_FULL_REGRESSION_TESTS": false
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Portable release with full regression tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "PARALLELASSEMBLYCPP_BUILD_TELEMETRY": true,
        "PARALLELASSEMBLYCPP_FULL_REGRESSION_TESTS": true
      }
    },
    {
      "name": "release",
      "displayName": "Portable release",
      "description": "Portable install and package build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "PARALLELASSEMBLYCPP_BUILD_TELEMETRY": false,
        "PARALLELASSEMBLYCPP_X86_64_V3": false
      }
    },
    {
      "name": "performance",
      "displayName": "x86-64-v3 performance",
      "description": "Optimized build with telemetry",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "PARALLELASSEMBLYCPP_BUILD_TELEMETRY": true,
        "PARALLELASSEMBLYCPP_X86_64_V3": true
      }
    },
    {
      "name": "performance-lto",
      "displayName": "x86-64-v3 LTO",
      "description": "Performance build with link-time optimization",
      "inherits": "performance",
      "cacheVariables": {
        "PARALLELASSEMBLYCPP_ENABLE_LTO": true
      }
    },
    {
      "name": "parallel",
      "displayName": "Parallel experiments",
      "description": "OpenMP, MPI, and hybrid scaling builds",
      "inherits": "performance",
      "cacheVariables": {
        "PARALLELASSEMBLYCPP_BUILD_OPENMP": true,
        "PARALLELASSEMBLYCPP_BUILD_MPI": true,
        "PARALLELASSEMBLYCPP_BUILD_HYBRID": true
      }
    },
    {
      "name": "parallel-tests",
      "displayName": "Parallel correctness tests",
      "description": "Portable OpenMP, MPI, hybrid, and telemetry test build",
      "inherits": "parallel",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "PARALLELASSEMBLYCPP_X86_64_V3": false
      }
    },
    {
      "name": "pgo-generate",
      "displayName": "PGO training",
      "description": "GCC-instrumented profile generation build",
      "inherits": "performance",
      "cacheVariables": {
        "PARALLELASSEMBLYCPP_ENABLE_LTO": true,
        "PARALLELASSEMBLYCPP_PGO_PHASE": "GENERATE",
        "PARALLELASSEMBLYCPP_PGO_PROFILE_DIR": "${sourceDir}/build/pgo-profiles"
      }
    },
    {
      "name": "performance-pgo",
      "displayName": "x86-64-v3 PGO and LTO",
      "description": "GCC profile-use build with LTO",
      "inherits": "performance",
      "cacheVariables": {
        "PARALLELASSEMBLYCPP_ENABLE_LTO": true,
        "PARALLELASSEMBLYCPP_PGO_PHASE": "USE",
        "PARALLELASSEMBLYCPP_PGO_PROFILE_DIR": "${sourceDir}/build/pgo-profiles"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "performance",
      "configurePreset": "performance"
    },
    {
      "name": "performance-lto",
      "configurePreset": "performance-lto"
    },
    {
      "name": "parallel",
      "configurePreset": "parallel"
    },
    {
      "name": "parallel-tests",
      "configurePreset": "parallel-tests"
    },
    {
      "name": "pgo-generate",
      "configurePreset": "pgo-generate"
    },
    {
      "name": "pgo-train",
      "configurePreset": "pgo-generate",
      "targets": [
        "pgo-train"
      ]
    },
    {
      "name": "performance-pgo",
      "configurePreset": "performance-pgo",
      "cleanFirst": true
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "parallel-tests",
      "configurePreset": "parallel-tests",
      "filter": {
        "include": {
          "label": "parallel"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "packagePresets": [
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
