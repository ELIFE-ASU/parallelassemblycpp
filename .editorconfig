root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,py}]
indent_style = space
indent_size = 4

# These are fixed-width or delimiter-sensitive data formats.
[*.{mol,tsv}]
trim_trailing_whitespace = false

[*.{cmake,cmake.in,json,json.in,md,toml,tsv,yaml,yml}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
